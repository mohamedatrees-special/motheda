# GEMINI_API_KEY: Optional AI assistant / catalog enrichment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
PORT=3000

# Store WhatsApp Click-to-Chat Phone (International format without '+' e.g. 201012345678)
STORE_WHATSAPP_NUMBER="201012345678"

# Paymob Payment Gateway Credentials (Sandbox / Production)
PAYMOB_API_KEY="placeholder_paymob_api_key"
PAYMOB_SECRET_KEY="placeholder_paymob_secret_key"
PAYMOB_PUBLIC_KEY="placeholder_paymob_public_key"
PAYMOB_INTEGRATION_ID_CARD="placeholder_card_integration_id"
PAYMOB_INTEGRATION_ID_WALLET="placeholder_wallet_integration_id"
PAYMOB_INTEGRATION_ID_VALU="placeholder_valu_integration_id"
PAYMOB_IFRAME_ID="placeholder_iframe_id"
PAYMOB_HMAC_SECRET="placeholder_paymob_hmac_secret"
PAYMOB_BASE_URL="https://accept.paymob.com/api"

# Administrative Security & OTP
ADMIN_JWT_SECRET="super_secret_jwt_admin_token_key_change_in_production"
ADMIN_OTP_SECRET="otp_secure_seed_key_for_hashing"
ADMIN_DEFAULT_RECOVERY_CODE="MOTAHEDA-EMERGENCY-2026-X99"

# Optional Automated Notifications (Email / WhatsApp Cloud API / Twilio)
ENABLE_WHATSAPP_NOTIFICATIONS=false
WHATSAPP_PROVIDER=""
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v20.0"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
RESEND_API_KEY=""
SUPPORT_EMAIL="support@almotaheda-electric.com"
